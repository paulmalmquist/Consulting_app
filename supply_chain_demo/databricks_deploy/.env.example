# Databricks workspace connection
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=dapi...

# Cluster for running notebooks (required unless DATABRICKS_ALLOW_NEW_CLUSTER=true)
DATABRICKS_CLUSTER_ID=

# SQL Warehouse for verify_databricks_seed.py (required for verification)
DATABRICKS_SQL_WAREHOUSE_ID=

# Catalog and schema names
DATABRICKS_CATALOG=supply_chain_demo
DATABRICKS_BRONZE_SCHEMA=bronze
DATABRICKS_SILVER_SCHEMA=silver
DATABRICKS_GOLD_SCHEMA=semantic

# Workspace path for uploaded notebooks.
# Leave as-is to auto-detect from your token's user email.
DATABRICKS_NOTEBOOK_PATH=/Users/<your-email@domain.com>/supply_chain_demo

# Set true to allow seed_workspace.py to provision an ephemeral cluster when
# DATABRICKS_CLUSTER_ID is blank. Requires Standard/Premium tier.
DATABRICKS_ALLOW_NEW_CLUSTER=false
