# macOS resource forks (external drives)
._*

# Per-deploy git SHA captured by scripts/deploy_backend.sh before `railway up`.
# Read at backend startup and exposed via /version. Not source.
backend/.git_sha

# Angular specific
/dist/
/out-tsc/
/tmp/
/coverage/
/e2e/test-output/
/.angular/
.angular/

# Node modules and dependency files
node_modules/
/package-lock.json
/yarn.lock

# Environment files
/.env
/.env.*
!/.env.example

# Angular CLI and build artefacts
/.angular-cli.json
/.ng/

# TypeScript cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Local secrets / scratch
godaddy.txt
godaddy2.txt
verceltoken.txt
openaikey.txt
*token*.txt
*pat*.txt
*key*.txt
trainingkey.txt

# Python virtualenvs and local env files (all subdirectories)
**/.venv/
**/.venv*/
**/.env
**/.env.*
!**/.env.example

# Python cache artifacts
**/__pycache__/
*.pyc

# Next.js build/export output
**/out/
**/.next/

