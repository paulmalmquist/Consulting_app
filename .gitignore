docs/assets/*.png
*.HEIC
*.heic
Hall Boys*
docs/assets/*.html

# Generated/synthetic data
synthetic_repe_dataset.json

# Generated audit run outputs — timestamped run directories and per-entity
# authoritative-state snapshots produced by verification scripts and the
# Meridian surface drift / hierarchy trace runners. Keep hand-curated summary
# files (findings.md, audit_summary.json, etc.) but ignore bulk output.
audit/meridian_surface_drift/meridian-*/
audit/meridian_hierarchy_trace/meridian-*/
audit/meridian_hierarchy_trace/authoritative_period_state.*.json
audit/backfill/
audit/verification_run_*/
audit/ui_gross_to_net/

# Pitch Forge generated iteration outputs — critique JSON and final deck are
# produced on each run; committed intentionally only when curated.
demo_docs/**/pitch_forge/final/
demo_docs/**/pitch_forge/iteration_*/critique.json
demo_docs/**/pitch_forge/iteration_*/critique_summary.md
demo_docs/**/pitch_forge/iteration_3/
~$*
TaxHacker-main/
# Lock files
.~lock*
pretext-main/
mandalore/
client-hunting/
job-search/

# Font source archives
abadi-font-family.zip
abadi-font-family/

# Novendor wordmark source kit — track source files, ignore generated
# binaries (re-buildable via `python build_font.py`; production copies
# live in repo-b/public/fonts/)
novendor_type_source/**/dist/

# Altered Mind: private practice data — never commit
data/altered-mind/
Altered Mind Weekly Business Check In.xlsx

# Visual-direction design canvases — exploratory mockups for the
# /what-we-do hero infographic. Selected pieces are imported into
# repo-b/ on adoption; the canvases themselves stay local-only.
new_homepage/
nv_mark_transparent_files/
nv_mark_transparent_files.zip
novendor_business_to_ai_visual_directions.html

# Host runner output (per-run JSON, not worth versioning)
scripts/results/*.json
!scripts/results/.gitkeep
