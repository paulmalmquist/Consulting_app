# Optional environment overrides for Outlook Assistant.
# Copy to scripts/outlook_assistant/.env and set only the values you want to override.

OUTLOOK_ASSISTANT_DEFAULT_ACCOUNT=Work
OUTLOOK_ASSISTANT_APPROVAL_MODE=true
OUTLOOK_ASSISTANT_ARCHIVE_FOLDER=Low Value
OUTLOOK_ASSISTANT_ATTACHMENT_SAVE_DIR=~/Downloads/outlook_attachments
OUTLOOK_ASSISTANT_LOG_FILE=scripts/outlook_assistant/logs/actions.jsonl
OUTLOOK_ASSISTANT_PENDING_ACTIONS_FILE=scripts/outlook_assistant/runtime/pending_actions.json
OUTLOOK_ASSISTANT_REPLY_SIGNATURE="Best,\nPaul"
